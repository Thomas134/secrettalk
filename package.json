{
  "name": "secrettalk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "密语 SecretTalk · 零知识中继 + 混合密码学的端到端加密聊天",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "dev:server": "tsx watch server/server.ts",
    "start:pm2": "npm run build:server && pm2 start ecosystem.config.cjs",
    "stop:pm2": "pm2 delete ecosystem.config.cjs",
    "logs:pm2": "pm2 logs",
    "serve:web": "node scripts/serve-web.cjs",
    "gen:certs": "node scripts/gen-certs.cjs",
    "start:local": "node scripts/start-local.cjs",
    "start:cloud": "node scripts/cloud-start.mjs",
    "share": "node scripts/share.mjs",
    "start:all": "npm run build && npm run build:server && npm run gen:certs && pm2 start ecosystem.config.cjs",
    "stop:all": "pm2 delete ecosystem.config.cjs",
    "status:all": "pm2 ls",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "node-forge": "^1.4.3",
    "pm2": "^7.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shamir-secret-sharing": "^0.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
